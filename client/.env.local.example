# API URL for backend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Socket.IO URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Application name
NEXT_PUBLIC_APP_NAME=HRMS Enterprise

# Default company ID (optional, for development)
NEXT_PUBLIC_DEFAULT_COMPANY_ID=

# Default branch ID (optional)
NEXT_PUBLIC_DEFAULT_BRANCH_ID=

# Google Maps API Key (for location tracking in attendance)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Feature flags
NEXT_PUBLIC_ENABLE_FINGERPRINT=true
NEXT_PUBLIC_ENABLE_FACIAL_RECOGNITION=true
NEXT_PUBLIC_ENABLE_QR_CODE=true
NEXT_PUBLIC_ENABLE_BARCODE=true